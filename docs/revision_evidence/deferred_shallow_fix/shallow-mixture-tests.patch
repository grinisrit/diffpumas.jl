+using Test, DiffPumas
+using DiffPumas.Physics: property_stopping_power, property_straggling, property_cross_section
+
+@testset "Optional shallow porous dry endpoint" begin
+    tomography = DiffPumas.Tomography
+    cfg = tomography.MaterialConfig(1, 2, 3, 3, 2700., 1000., 1500., 50.)
+    physics = create_physics(MUON; n_energies=4, K_min=1., K_max=100.,
+        materials=[STANDARD_ROCK, WATER, AIR],
+        settings=PhysicsSettings(dedx_path="/nonexistent"))
+    # Independent, deliberately distinct constant properties reveal wrong recipes.
+    # Air serves only as a third synthetic table, not a geological porous model.
+    csda = [.002, .004, .008]
+    mixed = [.001, .003, .005]
+    variance = [.01, .03, .09]
+    hard = [.02, .05, .11]
+    for (i, table) in enumerate(physics.tables)
+        table.csda_stopping_power .= csda[i]
+        table.mixed_stopping_power .= mixed[i]
+        table.straggling .= variance[i]
+        table.cross_section .= hard[i]
+    end
+
+    for w in (0., 5e-13, 1e-12, 2e-12, 1e-8, .3, 1.)
+        mix, density = tomography.mc_cell_mixture_and_density(w, true, cfg)
+        expected = [.5*(1-w), w, .5*(1-w)] # rock, water, porous
+        @test density ≈ 1 / sum(expected ./ [2700., 1000., 1500.]) rtol=2e-15
+        @test density ≈ tomography.cell_density(w, true, cfg) rtol=2e-15
+        for (property, values) in (
+            (m -> property_stopping_power(physics, ENERGY_LOSS_CSDA, m, 10.), csda),
+            (m -> property_stopping_power(physics, ENERGY_LOSS_MIXED, m, 10.), mixed),
+            (m -> property_straggling(physics, m, 10.), variance),
+            (m -> property_cross_section(physics, m, 10.), hard))
+            @test property(mix) ≈ sum(expected .* values) rtol=2e-15
+        end
+        @test property_stopping_power(physics, ENERGY_LOSS_CSDA, mix, 10.) ≈
+            tomography.cell_stopping_power(physics, w, true, cfg, 10.) rtol=2e-15
+    end
+
+    # Each independent guard disables the optional recipe. Preserve the ordinary
+    # branch's existing <=1e-12 pure-rock shortcut rather than changing its scope.
+    for (shallow, disabled_cfg) in (
+        (false, cfg),
+        (true, tomography.MaterialConfig(1, 2, 3, 0, 2700., 1000., 1500., 50.)),
+        (true, tomography.MaterialConfig(1, 2, 3, 3, 2700., 1000., 1500., 0.))),
+        w in (0., 5e-13, .3)
+        mix, density = tomography.mc_cell_mixture_and_density(w, shallow, disabled_cfg)
+        effective_w = w <= 1e-12 ? 0. : w
+        @test density ≈ 1 / ((1-effective_w)/2700. + effective_w/1000.) rtol=2e-15
+        @test property_stopping_power(physics, ENERGY_LOSS_CSDA, mix, 10.) ≈
+            (1-effective_w)*csda[1] + effective_w*csda[2] rtol=2e-15
+    end
+
+    # Exact constant-stopping slab solution and its one-sided endpoint derivative.
+    distance = .2
+    energy0 = 10.
+    energy(w) = begin
+        mix, density = tomography.mc_cell_mixture_and_density(w, true, cfg)
+        energy0 + distance*density*property_stopping_power(physics, ENERGY_LOSS_CSDA, mix, energy0)
+    end
+    a = .5/2700. + .5/1500.
+    b = 1/1000. - a
+    s0 = .5*(csda[1] + csda[3])
+    ds = csda[2] - s0
+    for w in (0., 1e-12, .3)
+        e, _, ok = tomography.propagate_csda_cell_segment(physics, w, true, cfg,
+            distance, energy0, 1.)
+        @test ok
+        @test e ≈ energy(w) rtol=1e-14
+        analytic = distance*(ds*a - s0*b)/(a+b*w)^2
+        h = 1e-5
+        numerical = (-3energy(w) + 4energy(w+h) - energy(w+2h))/(2h)
+        @test numerical ≈ analytic rtol=2e-8
+    end
+    @test abs(energy(2e-12) - energy(0.)) < 1e-10
+end
