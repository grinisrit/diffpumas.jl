# LVD generated outputs; keep the committed lvd_conf input data visible.
examples/data/lvd_*/
examples/data/*_backup_*/
# Revision executions stay local; curated evidence is copied into docs/revision_evidence.
examples/data/revision_20*/
examples/data/revision_quadrature_*/
examples/data/revision_robustness_*/
examples/data/revision_flat_comparison_*/
examples/data/revision_flat_controls_*/
examples/data/tetra_geometry_verification_*/
# Re-include lvd_conf LAST so the input data stays tracked (must follow the globs above).
!examples/data/lvd_conf/
!examples/data/lvd_conf/**

